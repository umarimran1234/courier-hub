PORT=3000
DATABASE_URL=postgresql://courier:courier@localhost:5432/courierhub
REDIS_URL=redis://localhost:6379

# Operator key for POST /v1/admin/tenants  (long random string)
ADMIN_KEY=change-me
# 64 hex chars (32 bytes). Generate: openssl rand -hex 32   -- losing it makes stored courier credentials unreadable
ENCRYPTION_KEY=

# Background tracking sync
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=30
SYNC_MIN_RECHECK_MINUTES=15

# Platform courier credentials for tenant-less tracking (/v1/track/*). JSON, one line.
# Merchants connect nothing; YOUR courier accounts are used to look up any tracking number.
PLATFORM_COURIERS={"POSTEX":{"token":""},"LEOPARDS":{"apiKey":"","apiPassword":""},"TCS":{"username":"","password":"","clientId":"","clientSecret":""}}
# Result cache (final states like DELIVERED are cached 1h regardless)
TRACK_CACHE_SECONDS=60
